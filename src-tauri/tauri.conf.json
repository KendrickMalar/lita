{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lita",
  "version": "0.2.28",
  "identifier": "com.papillon6814.lita",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lita",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NUI1Q0JGQzFENDMxMzAKUldRd01kVEJ2MXhicDQzeVJxYXdYeGd4bytXQzdmTnU1YnFLeEJMVlNmZWMxRGNXT1JaZzFOR20K",
      "endpoints": [
        "https://github.com/KendrickMalar/lita/releases/latest/download/latest.json"
      ]
    }
  }
}
